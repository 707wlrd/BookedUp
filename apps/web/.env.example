# ─────────────────────────────────────────────────────────────────────────────
# BookedUp — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez toutes les valeurs.
# Ne commitez JAMAIS .env.local dans git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# URL publique de l'application (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NE PAS exposer côté client
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# ou en test : sk_test_...

# Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs des plans (Stripe Dashboard → Products)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# ── Resend (emails transactionnels) ───────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...

# Expéditeur vérifié dans Resend (domaine validé obligatoire en production)
RESEND_FROM_EMAIL=BookedUp <noreply@bookedup.fr>
RESEND_REPLY_TO=contact@bookedup.fr

# ── Anthropic (génération IA) ─────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Cron sécurisé ─────────────────────────────────────────────────────────────
# Secret arbitraire envoyé par Vercel Cron dans l'en-tête Authorization
# Générez avec : openssl rand -hex 32
CRON_SECRET=votre_secret_cron_ici

# ─────────────────────────────────────────────────────────────────────────────
# NOTES DE DÉPLOIEMENT
# ─────────────────────────────────────────────────────────────────────────────
# 1. Supabase Storage : créez les buckets "avatars" et "covers" (public read)
# 2. Supabase SQL : appliquez les migrations dans supabase/
#    - push_token_migration.sql
#    - onboarding_migration.sql
#    - waitlist_migration.sql
#    - recurring_migration.sql
# 3. Vercel Cron Jobs (vercel.json) :
#    - /api/reminders      → "0 8 * * *"   (rappels J-1 à 8h)
#    - /api/review-requests → "0 12 * * *"  (demandes d'avis à 12h)
# 4. Stripe Webhook : pointez vers https://votre-domaine.com/api/webhooks/stripe
#    Événements requis : checkout.session.completed
# ─────────────────────────────────────────────────────────────────────────────
